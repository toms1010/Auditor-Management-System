<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Dialog Background ===== -->
    <Style x:Key="DialogBackground" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Width" Value="480"/>
        <Setter Property="MaxHeight" Value="90%"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.18" Direction="270" Color="{StaticResource CardShadow}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Notification Banner ===== -->
    <Style x:Key="NotificationBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
        <Setter Property="BorderBrush" Value="#FCA5A5"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ===== Page header ===== -->
    <Style x:Key="PageHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Page header title -->
    <Style x:Key="PageHeaderTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="Lato"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== Card ===== -->
    <Style x:Key="DataCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="315" Color="{StaticResource CardShadow}"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
