<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design system color palette -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryHover">#1D4ED8</Color>
    <Color x:Key="PrimaryPressed">#1E40AF</Color>

    <Color x:Key="Sidebar">#111827</Color>
    <Color x:Key="SidebarHover">#1F2937</Color>
    <Color x:Key="SidebarText">#FFFFFF</Color>
    <Color x:Key="SidebarTextSecondary">#9CA3AF</Color>

    <Color x:Key="Background">#F8FAFC</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="PageBackground">#F5F7FB</Color>

    <Color x:Key="PrimaryText">#111827</Color>
    <Color x:Key="SecondaryText">#64748B</Color>
    <Color x:Key="Border">#E2E8F0</Color>
    <Color x:Key="BorderLight">#E5E7EB</Color>

    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessLight">#DCFCE7</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningLight">#FEF3C7</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="ErrorLight">#FEE2E2</Color>
    <Color x:Key="Info">#2563EB</Color>
    <Color x:Key="InfoLight">#DBEAFE</Color>

    <Color x:Key="BadgePending">#F59E0B</Color>
    <Color x:Key="BadgePendingLight">#FEF3C7</Color>
    <Color x:Key="BadgeVerified">#16A34A</Color>
    <Color x:Key="BadgeVerifiedLight">#DCFCE7</Color>
    <Color x:Key="BadgeFlagged">#DC2626</Color>
    <Color x:Key="BadgeFlaggedLight">#FEE2E2</Color>
    <Color x:Key="BadgeUnderReview">#2563EB</Color>
    <Color x:Key="BadgeUnderReviewLight">#DBEAFE</Color>
    <Color x:Key="BadgeRejected">#9CA3AF</Color>
    <Color x:Key="BadgeRejectedLight">#F3F4F6</Color>

    <Color x:Key="Divider">#E5E7EB</Color>
    <Color x:Key="Shadow">#00000014</Color>
    <Color x:Key="CardShadow">#0000001A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHover}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressed}"/>

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Sidebar}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHover}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarText}"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="{StaticResource SidebarTextSecondary}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLight}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLight}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLight}"/>

    <SolidColorBrush x:Key="BadgePendingBrush" Color="{StaticResource BadgePending}"/>
    <SolidColorBrush x:Key="BadgePendingLightBrush" Color="{StaticResource BadgePendingLight}"/>
    <SolidColorBrush x:Key="BadgeVerifiedBrush" Color="{StaticResource BadgeVerified}"/>
    <SolidColorBrush x:Key="BadgeVerifiedLightBrush" Color="{StaticResource BadgeVerifiedLight}"/>
    <SolidColorBrush x:Key="BadgeFlaggedBrush" Color="{StaticResource BadgeFlagged}"/>
    <SolidColorBrush x:Key="BadgeFlaggedLightBrush" Color="{StaticResource BadgeFlaggedLight}"/>
    <SolidColorBrush x:Key="BadgeUnderReviewBrush" Color="{StaticResource BadgeUnderReview}"/>
    <SolidColorBrush x:Key="BadgeUnderReviewLightBrush" Color="{StaticResource BadgeUnderReviewLight}"/>
    <SolidColorBrush x:Key="BadgeRejectedBrush" Color="{StaticResource BadgeRejected}"/>
    <SolidColorBrush x:Key="BadgeRejectedLightBrush" Color="{StaticResource BadgeRejectedLight}"/>

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource Shadow}"/>
    <SolidColorBrush x:Key="CardShadowBrush" Color="{StaticResource CardShadow}"/>

    <!-- Accent brushes keyed by text -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource Primary}"/>
</ResourceDictionary>
