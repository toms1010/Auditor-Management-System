<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>

    <!-- Sidebar brushes -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#9CA3AF"/>

    <!-- Page background -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>

    <!-- Text brushes -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E7EB"/>

    <!-- Status/semantic brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#DBEAFE"/>

    <!-- Card / overlay -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#00000014"/>
    <SolidColorBrush x:Key="CardShadowBrush" Color="#0000001A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB"/>

    <!-- Badge fills -->
    <SolidColorBrush x:Key="BadgePendingBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BadgePendingLightBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BadgeVerifiedBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="BadgeVerifiedLightBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="BadgeFlaggedBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="BadgeFlaggedLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="BadgeUnderReviewBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="BadgeUnderReviewLightBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BadgeRejectedBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BadgeRejectedLightBrush" Color="#F3F4F6"/>
</ResourceDictionary>
