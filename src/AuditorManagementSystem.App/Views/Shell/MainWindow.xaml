<Window x:Class="AuditorManagementSystem.App.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AuditorManagementSystem.App.Views.Shell"
        mc:Ignorable="d"
        Title="Auditor Management System"
        Width="1360" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="0,24,0,0">
            <StackPanel>
                <!-- Logo -->
                <Border Padding="24,0,24,32">
                    <StackPanel>
                        <TextBlock Text="AuditorMS" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource SidebarTextBrush}" FontFamily="{StaticResource Lato}"/>
                        <TextBlock Text="Auditor Management System" FontSize="11"
                                   Foreground="{StaticResource SidebarTextSecondaryBrush}" Margin="0,4,0,0"
                                   FontFamily="{StaticResource Lato}"/>
                    </StackPanel>
                </Border>

                <!-- Group headers -->
                <ItemsControl ItemsSource="{Binding SidebarGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SidebarGroup}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Navigation items -->
                <ListBox ItemsSource="{Binding SidebarItems}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedNavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Style="{StaticResource NavItemButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Page}" Padding="16,10"
                                    Width="240" HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Bottom user section -->
                <Border Padding="20,32,20,0" Margin="0,24,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SidebarTextBrush}" Margin="0,0,0,4"
                                   FontFamily="{StaticResource Lato}"/>
                        <TextBlock Text="{Binding CurrentUser.Role}" FontSize="11"
                                   Foreground="{StaticResource SidebarTextSecondaryBrush}" Margin="0,0,0,16"
                                   FontFamily="{StaticResource Lato}"/>
                        <Button Content="Logout" Height="40" Background="{StaticResource ErrorBrush}" Foreground="White"
                                BorderThickness="0" FontFamily="{StaticResource Lato}" FontSize="14" FontWeight="SemiBold"
                                Command="{Binding NavigateCommand}" CommandParameter="Logout"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BorderLightBrush}" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource Lato}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="24,0,0,0">
                        <TextBlock Text="{Binding CurrentUser.Username}" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontFamily="{StaticResource Lato}"/>
                        <TextBlock Text="Search" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   MouseLeftButtonUp="Search_OnMouseLeftButtonUp" FontFamily="{StaticResource Lato}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" Padding="0,16,0,0">
                <ContentControl Content="{Binding CurrentView}"
                                Margin="0,0,0,24">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <ContentPresenter/>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
