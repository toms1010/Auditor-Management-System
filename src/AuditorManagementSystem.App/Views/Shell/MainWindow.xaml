<Window x:Class="AuditorManagementSystem.App.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AuditorManagementSystem.App.Views.Shell"
        mc:Ignorable="d"
        Title="Auditor Management System"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#111827" Padding="0,24,0,0">
            <StackPanel>
                <Border Padding="20,0,20,32">
                    <StackPanel>
                        <TextBlock Text="AuditorMS" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Auditor Management System" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Height="44" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="20,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{Binding IsVisible, Converter={StaticResource BoolToBrushConverter}}"
                                    FontSize="14" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Page}"
                                    Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="20,32,20,0" Margin="0,24,0,0" BorderThickness="0,1,0,0" BorderBrush="#374151">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentUser.Role}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,16"/>
                        <Button Content="Logout" Height="40" Background="#DC2626" Foreground="White" BorderThickness="0"
                                Command="{Binding NavigateCommand}" CommandParameter="Logout"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{Binding CurrentUser.Username}" FontSize="13" Foreground="#111827" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Padding="24"/>
        </Grid>
    </Grid>
</Window>
