<Window x:Class="AuditorManagementSystem.App.Views.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auditor Management System - Sign In"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">
    <Border Padding="40" Background="#F5F7FB">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
            <TextBlock Text="Auditor Management System" FontSize="24" FontWeight="SemiBold"
                       Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Sign in to your account" FontSize="14" Foreground="#6B7280"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="Username or Email" FontSize="12" FontWeight="Medium" Foreground="#6B7280" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40"
                     Padding="12,0" FontSize="14" Margin="0,0,0,16"/>

            <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Foreground="#6B7280" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Height="40" Padding="12,0" FontSize="14"
                         Margin="0,0,0,20" PasswordChanged="PasswordBox_PasswordChanged"/>

            <Button Content="Sign In" Height="44" FontSize="14" FontWeight="SemiBold"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    Margin="0,0,0,12" Command="{Binding LoginCommand}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Height="1" Background="#E5E7EB" Margin="0,0,0,16"/>

            <TextBlock Text="Default admin: admin / Admin123!" FontSize="11" Foreground="#9CA3AF"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
